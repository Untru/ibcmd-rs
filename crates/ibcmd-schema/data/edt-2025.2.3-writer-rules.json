      "modelType": "FormChoiceList",
      "feature": "values",
      "operations": [
        "write feature wrapper",
        "for each value write xr:item",
        "write empty xr:presentation",
        "write xr:checkState with lexical value 0",
        "write xr:value with xsi:type FormChoiceListDesTimeValue",
        "write presentation",
        "delegate value to FormSmartFeatureWriter"
      ],
      "conditions": [
        "feature must be many-valued and owned by the expected EClass",
        "empty collection writes an empty wrapper only when writeDefault is true",
        "write picture only for project version 8.5.1 or newer"
      ],
      "delegate": "com._1c.g5.v8.dt.form.export.xml.writer.FormSmartFeatureWriter",
      "policy": {
        "kind": "form-choice-list",
        "itemOrder": [
          "presentation",
          "check-state",
          "value"
        ],
        "emptyCollection": "write-wrapper-when-write-default"
      },
      "evidence": {
        "kind": "javap-bytecode",
        "status": "verified",
        "note": "Control flow, element order, defaults, delegation, and platform gate independently transcribed."
      }
    },
