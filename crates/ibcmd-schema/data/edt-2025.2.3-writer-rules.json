      "modelType": "DynamicListExtInfo",
      "feature": "listSettings",
      "operations": [
        "read listSettings feature",
        "delegate non-null settings to DcsV8Serializer.writeSettings with project context"
      ],
      "conditions": [
        "do not synthesize settings when feature value is null"
