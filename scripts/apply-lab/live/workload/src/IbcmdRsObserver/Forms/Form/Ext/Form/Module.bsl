// Owned bounded BSP document/report workload. Startup label;mode;absolute journal directory.
// File label.go arms writes; label.pause retains warm session; label.stop ends polling.
&НаКлиенте
Перем Метка;
&НаКлиенте
Перем Каталог;
&НаКлиенте
Перем НомерСеанса;
&НаКлиенте
Перем Счетчик;
&НаКлиенте
Перем Завершение;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Части = СтрРазделить(ПараметрЗапуска, ";", Ложь);
	Если Части.Количество() <> 3 Тогда
		ВызватьИсключение "workload requires label;mode;directory";
	КонецЕсли;
	Метка = Части[0]; Каталог = Части[2]; Счетчик = 0;
	НомерСеанса = НомерНаСервере();
	Завершение = ТекущаяУниверсальнаяДатаВМиллисекундах() + 600000;
	Журнал("open", "", "", "bounded=600s;doc=_ДемоСчетНаОплатуПокупателю;report=_ДемоОтчетПоСчетамНаОплатуГлобальный");
	Опрос(); ПодключитьОбработчикОжидания("Опрос", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Опрос() Экспорт
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Завершение Или Флаг("stop") Тогда
		ОтключитьОбработчикОжидания("Опрос"); Журнал("done", "", "", "attempts=" + Счетчик); Возврат;
	КонецЕсли;
	Клиент = ""; Сервер = "";
	Попытка
		Клиент = ОбсужденияСлужебныйКлиентСервер.ТипыВнешнихСистем().Telegram;
	Исключение
		Журнал("client-error", "", "", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Сервер = МаркерСервера();
	Исключение
		Журнал("server-error", Клиент, "", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Не Флаг("go") Или Флаг("pause") Тогда
		Журнал("warm", Клиент, Сервер, "paused"); Возврат;
	КонецЕсли;
	Счетчик = Счетчик + 1; НачатаТранзакция = Ложь;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Журнал("operation-start", Клиент, Сервер, "attempt=" + Счетчик + ";commit_not_established=1");
	Попытка
		Результат = ВыполнитьОперацию(Метка, Счетчик);
		Журнал("operation", Клиент, Сервер, "attempt=" + Счетчик + ";client_ms=" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах()-Начало,"ЧГ=0") + ";" + Результат);
	Исключение
		Журнал("call-error", Клиент, Сервер, "attempt=" + Счетчик + ";committed=unknown;" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция Флаг(Имя)
	ФайлФлага = Новый Файл(Каталог + Метка + "." + Имя);
	Возврат ФайлФлага.Существует();
КонецФункции

&НаКлиенте
Процедура Журнал(Событие, Клиент, Сервер, Подробности)
	Запись = Новый ЗаписьТекста(Каталог + Метка + ".log", КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(),"ЧГ=0") + "|" + Метка + "|" + Событие + "|" + НомерСеанса + "|" + Клиент + "|" + Сервер + "|" + СтрЗаменить(СтрЗаменить(СтрЗаменить(Подробности,Символы.ПС," "),Символы.ВК," "),"|","/"));
	Запись.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерНаСервере()
	Возврат Формат(НомерСеансаИнформационнойБазы(),"ЧГ=0");
КонецФункции

&НаСервереБезКонтекста
Функция МаркерСервера()
	Возврат ОбсужденияСлужебныйКлиентСервер.ТипыВнешнихСистем().Telegram;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьОперацию(Знач Метка, Знач Номер)
	НачатаТранзакция = Ложь;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ._ДемоСчетНаОплатуПокупателю ГДЕ НЕ ПометкаУдаления И Проведен УПОРЯДОЧИТЬ ПО Дата, Ссылка");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда ВызватьИсключение "no posted BSP invoice template"; КонецЕсли;
		Документ = Выборка.Ссылка.ПолучитьОбъект().Скопировать();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Комментарий = "ibcmd-rs-load:" + Метка + ":" + Формат(Номер,"ЧГ=0");
		НачатаТранзакция = Истина;
		НачатьТранзакцию();
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		Возврат "committed=" + ?(НачатаТранзакция, "unknown", "0") + ";doc-error=" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Текст = "committed=1;doc_uuid=" + Строка(Документ.Ссылка.УникальныйИдентификатор()) + ";doc_ms=" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах()-Начало,"ЧГ=0");
	НачалоОтчета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Отчет = Отчеты._ДемоОтчетПоСчетамНаОплатуГлобальный.Создать();
		Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
		ТабДок = Новый ТабличныйДокумент;
		Отчет.СкомпоноватьРезультат(ТабДок);
		Если ТабДок.ВысотаТаблицы = 0 Тогда ВызватьИсключение "empty BSP report"; КонецЕсли;
		Текст = Текст + ";report_ok=1;report_rows=" + ТабДок.ВысотаТаблицы + ";report_ms=" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах()-НачалоОтчета,"ЧГ=0");
	Исключение
		Текст = Текст + ";report_ok=0;report-error=" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Текст;
КонецФункции



