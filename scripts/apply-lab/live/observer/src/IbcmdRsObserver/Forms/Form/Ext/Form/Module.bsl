// Наблюдатель за поколением конфигурации и генератор нагрузки (лабораторная обработка ibcmd-rs, задачи #344 и #409 F-5).
// Запускается ключом /Execute с параметром запуска "метка;режим;каталог-журнала" (каталог необязателен, по умолчанию
// F:\ibcmd\lab\05\live\obs\).
//   режим poll   - раз в секунду читает маркеры общего модуля клиент-сервер и пишет строку в журнал;
//   режим lazy   - пока нет файла <метка>.go, модуль не трогает (только пульс), потом как poll;
//   режим txn    - то же, а когда появляется файл <метка>.go, открывает на сервере транзакцию, пишет
//                  константу и держит транзакцию открытой 60 секунд (пока идёт активация);
//   режим writer - как poll, и каждую секунду серверный вызов пишет серию коротких транзакций (константа), то есть сеанс
//                  постоянно пишет в базу: нагрузка для переключения live.
// Строка журнала: миллисекунды UTC от 0001-01-01|метка|событие|номер сеанса|маркер клиента|маркер сервера|подробности.

&НаКлиенте
Перем Метка;

&НаКлиенте
Перем ПутьЖурнала;

&НаКлиенте
Перем Режим;

&НаКлиенте
Перем НомерСеанса;

&НаКлиенте
Перем ПутьФлага;

&НаКлиенте
Перем ЗаписьЗапущена;

&НаКлиенте
Перем Счётчик;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Части = СтрРазделить(ПараметрЗапуска, ";", Ложь);
	Метка = ?(Части.Количество() > 0, Части[0], "без-метки");
	Режим = ?(Части.Количество() > 1, Части[1], "poll");
	Каталог = ?(Части.Количество() > 2, Части[2], "F:\ibcmd\lab\05\live\obs\");
	ПутьЖурнала = Каталог + Метка + ".log";
	ПутьФлага = Каталог + Метка + ".go";
	ЗаписьЗапущена = Ложь;
	Счётчик = 0;
	Попытка
		НомерСеанса = НомерСеансаНаСервере();
	Исключение
		НомерСеанса = "?";
	КонецПопытки;

	ЧерновикТекста = "черновик-" + Метка + "-" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss");
	Модифицированность = Истина;

	Журнал("open", "", "", "режим=" + Режим);
	Опрос();
	ПодключитьОбработчикОжидания("Опрос", 1, Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Опрос() Экспорт

	Если Режим = "lazy" И Не ЗаписьЗапущена Тогда
		// Сеанс открыт, но общий модуль ещё не тронут: ждём файла-флага.
		Попытка
			ФайлФлага = Новый Файл(ПутьФлага);
			Если ФайлФлага.Существует() Тогда
				ЗаписьЗапущена = Истина;
				Журнал("lazy-armed", "", "", "");
			КонецЕсли;
		Исключение
			Журнал("lazy-flag-error", "", "", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Не ЗаписьЗапущена Тогда
			Журнал("beat", "", "", "черновик=" + ЧерновикТекста);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Подробности = "";

	Попытка
		Клиент = ОбсужденияСлужебныйКлиентСервер.ТипыВнешнихСистем().Telegram;
	Исключение
		Клиент = "ОШИБКА";
		Подробности = Подробности + "клиент: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " ";
	КонецПопытки;

	Попытка
		Сервер = МаркерСервера();
	Исключение
		Сервер = "ОШИБКА";
		Подробности = Подробности + "сервер: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " ";
	КонецПопытки;

	// Второй общий модуль: функции IbcmdRsMarkerB в исходном поколении нет ("нет" = метод не найден).
	Попытка
		КлиентБ = РаботаСКлассификаторамиКлиентСервер.IbcmdRsMarkerB();
	Исключение
		КлиентБ = "нет";
	КонецПопытки;
	Попытка
		СерверБ = МаркерСервераБ();
	Исключение
		СерверБ = "нет";
	КонецПопытки;
	Подробности = Подробности + "B=" + КлиентБ + "/" + СерверБ + " ";

	Подробности = Подробности + "черновик=" + ЧерновикТекста + " изм=" + Модифицированность;
	Журнал("poll", Клиент, Сервер, Подробности);

	Если Режим = "writer" Тогда
		Счётчик = Счётчик + 1;
		Попытка
			Результат = ЗаписатьСерию(Счётчик * 1000, 40);
		Исключение
			Результат = "ОШИБКА-ВЫЗОВА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Журнал("write", "", "", Результат);
	КонецЕсли;

	Если Режим = "txn" И Не ЗаписьЗапущена Тогда
		Попытка
			ФайлФлага = Новый Файл(ПутьФлага);
			Если ФайлФлага.Существует() Тогда
				ЗаписьЗапущена = Истина;
				ПодключитьОбработчикОжидания("ДлительнаяЗапись", 1, Истина);
			КонецЕсли;
		Исключение
			Журнал("txn-flag-error", "", "", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяЗапись() Экспорт

	Значение = Число(Формат(ТекущаяДата(), "ДФ=yyyyMMdd"));
	Журнал("txn-begin", "", "", "константа=" + Формат(Значение, "ЧГ=0") + " секунд=60");
	Попытка
		Результат = ДлительнаяЗаписьНаСервере(Значение, 60);
	Исключение
		Результат = "ОШИБКА-ВЫЗОВА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Журнал("txn-end", "", "", Результат);

КонецПроцедуры

&НаКлиенте
Процедура Журнал(Событие, Клиент, Сервер, Подробности)

	Строка = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + "|" + Метка + "|" + Событие + "|"
		+ НомерСеанса + "|" + Клиент + "|" + Сервер + "|"
		+ СтрЗаменить(СтрЗаменить(Подробности, Символы.ПС, " "), Символы.ВК, " ");
	Попытка
		Запись = Новый ЗаписьТекста(ПутьЖурнала, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Строка);
		Запись.Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерСеансаНаСервере()

	Возврат Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0");

КонецФункции

&НаСервереБезКонтекста
Функция МаркерСервера()

	Возврат ОбсужденияСлужебныйКлиентСервер.ТипыВнешнихСистем().Telegram;

КонецФункции

&НаСервереБезКонтекста
Функция МаркерСервераБ()

	Возврат РаботаСКлассификаторамиКлиентСервер.IbcmdRsMarkerB();

КонецФункции

// Серия коротких транзакций: сеанс, который пишет в базу без пауз (нагрузка).
&НаСервереБезКонтекста
Функция ЗаписатьСерию(Основа, Количество)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Записано = 0;
	Для Индекс = 1 По Количество Цикл
		Попытка
			НачатьТранзакцию();
			Константы._ДемоКодНовогоУзлаПланаОбмена.Установить(Основа + Индекс);
			ЗафиксироватьТранзакцию();
			Записано = Записано + 1;
		Исключение
			Описание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Попытка
				Пока ТранзакцияАктивна() Цикл
					ОтменитьТранзакцию();
				КонецЦикла;
			Исключение
			КонецПопытки;
			Возврат "записано " + Записано + " из " + Количество + ", ОШИБКА: " + Описание;
		КонецПопытки;
	КонецЦикла;

	Возврат "записано " + Записано + " за " + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧГ=0") + " мс";

КонецФункции

&НаСервереБезКонтекста
Функция ДлительнаяЗаписьНаСервере(Значение, Секунд)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачатьТранзакцию();
	Попытка
		Константы._ДемоКодНовогоУзлаПланаОбмена.Установить(Значение);
		Конец = Начало + Секунд * 1000;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		Описание = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			Пока ТранзакцияАктивна() Цикл
				ОтменитьТранзакцию();
			КонецЦикла;
		Исключение
		КонецПопытки;
		Возврат "ОШИБКА: " + Описание;
	КонецПопытки;

	Возврат "ЗАФИКСИРОВАНО за " + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧГ=0") + " мс";

КонецФункции

#КонецОбласти
